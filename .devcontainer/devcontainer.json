{
	"name": "Jekyll",
	"image": "mcr.microsoft.com/devcontainers/jekyll:2-bullseye",
	"forwardPorts": [4000],
	// Managed Python (the Jekyll image ships Python without pip).
	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.11"
		}
	},
	// Pillow for scripts/optimize_images.py.
	"postCreateCommand": "python3 -m pip install Pillow"
}
